CompileFlags:
  Add:
    - -Wall
    - -Wextra
    - -Wpedantic
    - -Wconversion
    - -Wsign-conversion
    - -Wshadow
    - -Wold-style-definition
    - -Wcast-align
    - -Wcast-qual
    - -Wundef
    - -Wdouble-promotion
    - -Wformat=2
    - -Wimplicit-fallthrough
    - -Wnull-dereference
    - -Wno-gnu-statement-expression-from-macro-expansion

---
If:
  PathMatch: .*\.(c|h)$
CompileFlags:
  Add:
    - -std=gnu17
    - -xc
  Remove:
    - -std=*

---
If:
  PathMatch: .*\.(cpp|hpp|cc|cxx)$
CompileFlags:
  Add:
    - -std=c++20
