profile ext {
    output "LG Electronics LG QHD 0x00011B7E" mode 2560x1440@143.999Hz enable position 0,0
}

profile both {
    output "LG Electronics LG QHD 0x00011B7E" mode 2560x1440@143.999Hz enable position 0,0
    output eDP-1 enable position 2560,0
}

profile nomad {
    output eDP-1 enable position 2560,0
    output "LG Electronics LG QHD 0x00011B7E"  disable
}
