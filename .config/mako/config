max-history=20
sort=-time
on-button-left=invoke-default-action
on-button-middle=dismiss
on-button-right=dismiss-all
font=Inconsolata Nerd Font
format=<small>%a</small>\n<b>%s</b>\n%b
width=300
height=300
outer-margin=0
margin=25
padding=12
border-size=1
border-radius=10
icons=1
icon-path=/usr/share/icons/Adwaita/symbolic/status/
markup=1
actions=1
history=1
text-alignment=left
default-timeout=3000
ignore-timeout=0
group-by=app-name
max-visible=5
layer=top
anchor=top-right

[mode=do-not-disturb]
invisible=1

[urgency=low]
background-color=#c4bdd3
text-color=#492e81
progress-color=#b6a3e0
border-color=#0D0D0D
default-timeout=3000

[urgency=normal]
background-color=#c4bdd3
text-color=#241740
progress-color=#a38ad8
border-color=#0D0D0D
default-timeout=8000

[urgency=critical]
background-color=#9b4d4bf0
text-color=#3b4d4b
progress-color=#000000
border-color=#F27329
default-timeout=15000
layer=overlay
