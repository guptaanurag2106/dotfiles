[
{
    "layer": "bottom",
    "position": "bottom",
    //"height": 32,
    //"width": 1350,
    "spacing": 0,
    "modules-left": [
        "custom/arch",
        "sway/workspaces",
        "custom/separator",
        "custom/scratchpad",
        "sway/mode",
        "custom/separator"
        //"mpd",
        //"sway/window",
    ],
    "modules-center": [
        "clock",
    ],
    "modules-right": [
        "idle_inhibitor",
        "custom/separator",
        "cpu",
        "custom/temperature",
        "custom/separator",
        "memory",
        "custom/separator",
        "disk",
        "custom/separator",
        "backlight",
        "custom/separator",
        "battery",
        "custom/separator",
        "custom/audio",
        "custom/separator",
        "custom/dunst",
        "network",
        "tray",
        "custom/power",
    ],
    "custom/arch": {
        "format": "  ",
        "tooltip": true,
        "tooltip-format": "btw",
    },
    "sway/workspaces": {
        "strip": 20,
        "disable-scroll": false,
        "all-outputs": false,
        "format": "{value}",
        "numeric-first": false,
    },
    "custom/scratchpad": {
      "interval": 5,
      "return-type": "json",
      "exec": "~/.config/scripts/scratchpad.sh",
      "exec-if": "exit 0",
      "on-click": "swaymsg scratchpad show",
      "on-click-right": "swaymsg move window to scratchpad",
      "tooltip": false
    },
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "sway/window": {
        "format": "{title}",
        "max-length": 50,
        "tooltip": true
    },
    "mpd": {
        "format": "{stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}{artist} - {album} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ⸨{songPosition}|{queueLength}⸩ ",
        "format-disconnected": "Disconnected ",
        "format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}Stopped ",
        "unknown-tag": "N/A",
        "interval": 2,
        "consume-icons": {
            "on": " "
        },
        "random-icons": {
            "off": "<span color=\"#f53c3c\"></span> ",
            "on": " "
        },
        "repeat-icons": {
            "on": " "
        },
        "single-icons": {
            "on": "1 "
        },
        "state-icons": {
            "paused": "",
            "playing": ""
        },
        "tooltip-format": "MPD (connected)",
        "tooltip-format-disconnected": "MPD (disconnected)"
    },
    "idle_inhibitor": {
        "format": "{icon} ",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        },
        "tooltip": false
    },
    "cpu": {
        "format": "{load} {usage}% {avg_frequency}GHz",
        "interval": 5,
        "on-click": "foot -e btop"
    },
    "memory": {
        "format": "{percentage}%",
        "interval": 5
    },
    "disk": {
        "interval": 10,
        "format": "{used}",
        "path": "/"
    },
    "backlight": {
        "interval": 5,
        "device": "intel_backlight",
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-",
        "format": "{icon}  {percent}%",
        "format-icons": ["", ""],
        "tooltip": false
    },
    "battery": {
        "states": {
            "good": 80,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "tooltip": true,
        "interval": 5,
        "tooltip-format": "{time}"
    },
    "custom/temperature": {
      "exec": "~/.config/scripts/cpu_temp.sh",
      "format": "{}",
      "return-type": "json",
      "interval": 10
    },
    "custom/audio": {
        "format": "{}",
        "signal": 8,
        "interval": 1,
        "exec": "/home/tanz/.config/scripts/audio.sh",
        "on-click": "pavucontrol",
        "on-scroll-up": "~/.config/scripts/wp-volume.sh 5%+",
        "on-scroll-down": "~/.config/scripts/wp-volume.sh 5%-"
    },
    "network": {
        // "interface": "wlp2s0", // (Optional) To force the use of this interface
        "interval": 5,
        "format": "⚠  Disabled",
        "format-wifi": " ",
        "format-ethernet": "  {ifname}: {ipaddr}/{cidr}",
        "format-disconnected": "⚠  Disconnected",
        "on-click": "~/.config/scripts/rofi_wifi_menu.sh",
        "tooltip-format": "{ifname}: {ipaddr}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%): {ipaddr}"
    },
    "clock": {
        "tooltip-format": "<big>{:%B:%Y}</big>\n\n<tt><small>{calendar}</small></tt>",
        "format": "{:%a %d/%m %H:%M}",
        "format-alt": " {:%H:%M}",
        "timezone": "Asia/Kolkata",
        "tooltip": true
    },
    "custom/dunst": {
        "exec": "~/.config/scripts/dunst.sh",
        "interval": 5,
        "tooltip": false,
    },
    "tray": {
      "spacing": 5,
      "show-passive-items": true
    },
    "custom/power": {
        "format": "⏻ ",
        "on-click": "~/.config/scripts/powermenu.sh",
        "tooltip": false,
    },
    "custom/separator": {
      "format": "|",
      "interval": "once",
      "tooltip": false
    },
}
]
